<jasperReport name="PaymentForEachProducer" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="0" uuid="e115bc59-fd0f-446b-a585-04725e27d7f0">
    <property name="com.jaspersoft.studio.data.defaultdataadapter" value="ConciliacionesDB"/>
    <style name="Title" fontName="SansSerif" fontSize="26.0" bold="true"/>
    <style name="SubTitle" forecolor="#666666" fontName="SansSerif" fontSize="18.0"/>
    <style name="Column header" forecolor="#FFFFFF" fontName="SansSerif" fontSize="11.0" bold="true"/>
    <style name="Detail" fontName="SansSerif" fontSize="10.0"/>

    <query language="sql"><![CDATA[
SELECT
    pr.full_name AS producerName,
    p.policyNumber AS policyNumber,
    csi.net_amount AS policyAmount,
    csi.rate AS commissionRate,
    csi.commissionRate_pct AS producerRate,
    csi.commissionAmount AS commissionAmount,
    cpd.amount AS paymentAmount
FROM reconciliation.commission_payment_detail cpd
INNER JOIN reconciliation.policy p
    ON p.id = cpd.policy_id
INNER JOIN reconciliation.commission_statement_item csi
    ON csi.id = cpd.commission_statement_item_id
INNER JOIN reconciliation.commission_statement cms
    ON cms.id = csi.commission_statement_id
LEFT JOIN reconciliation.producer pr
    ON pr.id = cms.producer_id
ORDER BY cpd.id DESC
LIMIT 100
    ]]></query>

    <field name="producerName" class="java.lang.String"/>
    <field name="policyNumber" class="java.lang.String"/>
    <field name="policyAmount" class="java.math.BigDecimal"/>
    <field name="commissionRate" class="java.math.BigDecimal"/>
    <field name="producerRate" class="java.math.BigDecimal"/>
    <field name="commissionAmount" class="java.math.BigDecimal"/>
    <field name="paymentAmount" class="java.math.BigDecimal"/>


    <variable name="PAGE_PAYMENT_TOTAL" class="java.math.BigDecimal" calculation="Sum" resetType="Page">
        <expression><![CDATA[$F{paymentAmount}]]></expression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>

